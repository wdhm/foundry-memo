{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.36.1.42791",
      "templateHash": "4093648577649929884"
    }
  },
  "parameters": {
    "baseName": {
      "type": "string",
      "defaultValue": "fmemo",
      "maxLength": 9,
      "metadata": {
        "description": "Base name for all resources (max 9 chars for Foundry naming)"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "swedencentral",
      "allowedValues": [
        "swedencentral",
        "eastus",
        "eastus2",
        "westus",
        "westus3",
        "northcentralus",
        "canadacentral",
        "southeastasia",
        "polandcentral",
        "southafricanorth",
        "koreacentral",
        "southindia",
        "brazilsouth",
        "norwayeast",
        "japaneast",
        "francecentral",
        "switzerlandnorth",
        "australiaeast"
      ],
      "metadata": {
        "description": "Azure region for all resources"
      }
    },
    "modelName": {
      "type": "string",
      "defaultValue": "gpt-5",
      "metadata": {
        "description": "Name of the GPT model to deploy"
      }
    },
    "modelFormat": {
      "type": "string",
      "defaultValue": "OpenAI",
      "metadata": {
        "description": "Model format"
      }
    },
    "modelVersion": {
      "type": "string",
      "defaultValue": "2025-08-07",
      "metadata": {
        "description": "Model version"
      }
    },
    "modelSkuName": {
      "type": "string",
      "defaultValue": "GlobalStandard",
      "metadata": {
        "description": "Model SKU"
      }
    },
    "modelCapacity": {
      "type": "int",
      "defaultValue": 40,
      "metadata": {
        "description": "Model capacity in TPM (tokens per minute, in thousands)"
      }
    },
    "projectName": {
      "type": "string",
      "defaultValue": "foundry-memo",
      "metadata": {
        "description": "Foundry project name"
      }
    },
    "projectDescription": {
      "type": "string",
      "defaultValue": "Hosted agent that generates PDF memos from SharePoint content via the Copilot Retrieval API.",
      "metadata": {
        "description": "Foundry project description"
      }
    },
    "graphAppClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Client ID of the Entra app registration for MCP OAuth (foundry-memo-graph)"
      }
    },
    "graphAppClientSecret": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Client secret for the Entra app registration (pass via azd env)"
      }
    },
    "agent365ToolsAppId": {
      "type": "string",
      "defaultValue": "ea9ffc3e-8a23-4a7d-836d-234d7c7565c1",
      "metadata": {
        "description": "App ID of Agent 365 Tools service principal"
      }
    },
    "developerPrincipalId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Principal ID of the developer for local Cosmos DB access (optional)"
      }
    }
  },
  "variables": {
    "uniqueSuffix": "[substring(uniqueString(resourceGroup().id), 0, 4)]",
    "accountName": "[toLower(format('{0}{1}', parameters('baseName'), variables('uniqueSuffix')))]",
    "acrPullRoleId": "7f951dda-4ed3-4680-a7ca-43fe172d538d",
    "cosmosDataContributorRoleId": "00000000-0000-0000-0000-000000000002",
    "foundryUserRoleId": "53ca6127-db72-4b80-b1b0-d745d6d5456d"
  },
  "resources": [
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2025-04-01-preview",
      "name": "[variables('accountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "S0"
      },
      "kind": "AIServices",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "allowProjectManagement": true,
        "customSubDomainName": "[variables('accountName')]",
        "networkAcls": {
          "defaultAction": "Allow",
          "virtualNetworkRules": [],
          "ipRules": []
        },
        "publicNetworkAccess": "Enabled",
        "disableLocalAuth": true
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/projects",
      "apiVersion": "2025-04-01-preview",
      "name": "[format('{0}/{1}', variables('accountName'), parameters('projectName'))]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "description": "[parameters('projectDescription')]",
        "displayName": "Foundry Memo"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('accountName'))]"
      ]
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2024-10-01",
      "name": "[format('{0}/{1}', variables('accountName'), parameters('modelName'))]",
      "sku": {
        "capacity": "[parameters('modelCapacity')]",
        "name": "[parameters('modelSkuName')]"
      },
      "properties": {
        "model": {
          "name": "[parameters('modelName')]",
          "format": "[parameters('modelFormat')]",
          "version": "[parameters('modelVersion')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('accountName'))]"
      ]
    },
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}acr{1}', parameters('baseName'), variables('uniqueSuffix'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Basic"
      },
      "properties": {
        "adminUserEnabled": false
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}-logs-{1}', parameters('baseName'), variables('uniqueSuffix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[format('{0}-insights-{1}', parameters('baseName'), variables('uniqueSuffix'))]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs-{1}', parameters('baseName'), variables('uniqueSuffix')))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs-{1}', parameters('baseName'), variables('uniqueSuffix')))]"
      ]
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts",
      "apiVersion": "2024-05-15",
      "name": "[format('{0}-cosmos-{1}', parameters('baseName'), variables('uniqueSuffix'))]",
      "location": "[parameters('location')]",
      "kind": "GlobalDocumentDB",
      "properties": {
        "databaseAccountOfferType": "Standard",
        "disableLocalAuth": true,
        "locations": [
          {
            "locationName": "[parameters('location')]",
            "failoverPriority": 0
          }
        ],
        "capabilities": [
          {
            "name": "EnableServerless"
          }
        ],
        "consistencyPolicy": {
          "defaultConsistencyLevel": "Session"
        }
      }
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases",
      "apiVersion": "2024-05-15",
      "name": "[format('{0}/{1}', format('{0}-cosmos-{1}', parameters('baseName'), variables('uniqueSuffix')), 'foundry-memo')]",
      "properties": {
        "resource": {
          "id": "foundry-memo"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DocumentDB/databaseAccounts', format('{0}-cosmos-{1}', parameters('baseName'), variables('uniqueSuffix')))]"
      ]
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases/containers",
      "apiVersion": "2024-05-15",
      "name": "[format('{0}/{1}/{2}', format('{0}-cosmos-{1}', parameters('baseName'), variables('uniqueSuffix')), 'foundry-memo', 'learnings')]",
      "properties": {
        "resource": {
          "id": "learnings",
          "partitionKey": {
            "paths": [
              "/pk"
            ],
            "kind": "Hash"
          },
          "indexingPolicy": {
            "automatic": true,
            "indexingMode": "consistent",
            "includedPaths": [
              {
                "path": "/*"
              }
            ]
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DocumentDB/databaseAccounts/sqlDatabases', format('{0}-cosmos-{1}', parameters('baseName'), variables('uniqueSuffix')), 'foundry-memo')]"
      ]
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/connections",
      "apiVersion": "2025-04-01-preview",
      "name": "[format('{0}/{1}', variables('accountName'), 'cosmos-db')]",
      "properties": {
        "category": "CosmosDb",
        "target": "[reference(resourceId('Microsoft.DocumentDB/databaseAccounts', format('{0}-cosmos-{1}', parameters('baseName'), variables('uniqueSuffix'))), '2024-05-15').documentEndpoint]",
        "authType": "AAD",
        "isSharedToAll": true,
        "metadata": {
          "DatabaseName": "foundry-memo"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('accountName'))]",
        "[resourceId('Microsoft.DocumentDB/databaseAccounts', format('{0}-cosmos-{1}', parameters('baseName'), variables('uniqueSuffix')))]",
        "[resourceId('Microsoft.DocumentDB/databaseAccounts/sqlDatabases', format('{0}-cosmos-{1}', parameters('baseName'), variables('uniqueSuffix')), 'foundry-memo')]"
      ]
    },
    {
      "condition": "[not(empty(parameters('graphAppClientId')))]",
      "type": "Microsoft.CognitiveServices/accounts/connections",
      "apiVersion": "2025-04-01-preview",
      "name": "[format('{0}/{1}', variables('accountName'), 'copilot-search-oauth')]",
      "properties": {
        "category": "RemoteTool",
        "target": "[format('https://login.microsoftonline.com/{0}/oauth2/v2.0', subscription().tenantId)]",
        "authType": "OAuth2",
        "isSharedToAll": true,
        "credentials": {
          "clientId": "[parameters('graphAppClientId')]",
          "clientSecret": "[parameters('graphAppClientSecret')]",
          "authUrl": "[format('https://login.microsoftonline.com/{0}/oauth2/v2.0/authorize', subscription().tenantId)]",
          "tenantId": "[subscription().tenantId]"
        },
        "metadata": {
          "Scopes": "[format('{0}/McpServers.CopilotMCP.All {1}/McpServers.OneDriveSharepoint.All', parameters('agent365ToolsAppId'), parameters('agent365ToolsAppId'))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('accountName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[format('Microsoft.ContainerRegistry/registries/{0}', format('{0}acr{1}', parameters('baseName'), variables('uniqueSuffix')))]",
      "name": "[guid(resourceId('Microsoft.ContainerRegistry/registries', format('{0}acr{1}', parameters('baseName'), variables('uniqueSuffix'))), resourceId('Microsoft.CognitiveServices/accounts/projects', variables('accountName'), parameters('projectName')), variables('acrPullRoleId'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.CognitiveServices/accounts/projects', variables('accountName'), parameters('projectName')), '2025-04-01-preview', 'full').identity.principalId]",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('acrPullRoleId'))]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', format('{0}acr{1}', parameters('baseName'), variables('uniqueSuffix')))]",
        "[resourceId('Microsoft.CognitiveServices/accounts/projects', variables('accountName'), parameters('projectName'))]"
      ]
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlRoleAssignments",
      "apiVersion": "2024-05-15",
      "name": "[format('{0}/{1}', format('{0}-cosmos-{1}', parameters('baseName'), variables('uniqueSuffix')), guid(resourceId('Microsoft.DocumentDB/databaseAccounts', format('{0}-cosmos-{1}', parameters('baseName'), variables('uniqueSuffix'))), resourceId('Microsoft.CognitiveServices/accounts/projects', variables('accountName'), parameters('projectName')), variables('cosmosDataContributorRoleId')))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.CognitiveServices/accounts/projects', variables('accountName'), parameters('projectName')), '2025-04-01-preview', 'full').identity.principalId]",
        "roleDefinitionId": "[format('{0}/sqlRoleDefinitions/{1}', resourceId('Microsoft.DocumentDB/databaseAccounts', format('{0}-cosmos-{1}', parameters('baseName'), variables('uniqueSuffix'))), variables('cosmosDataContributorRoleId'))]",
        "scope": "[resourceId('Microsoft.DocumentDB/databaseAccounts', format('{0}-cosmos-{1}', parameters('baseName'), variables('uniqueSuffix')))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts/projects', variables('accountName'), parameters('projectName'))]",
        "[resourceId('Microsoft.DocumentDB/databaseAccounts', format('{0}-cosmos-{1}', parameters('baseName'), variables('uniqueSuffix')))]"
      ]
    },
    {
      "condition": "[not(empty(parameters('developerPrincipalId')))]",
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlRoleAssignments",
      "apiVersion": "2024-05-15",
      "name": "[format('{0}/{1}', format('{0}-cosmos-{1}', parameters('baseName'), variables('uniqueSuffix')), guid(resourceId('Microsoft.DocumentDB/databaseAccounts', format('{0}-cosmos-{1}', parameters('baseName'), variables('uniqueSuffix'))), parameters('developerPrincipalId'), variables('cosmosDataContributorRoleId')))]",
      "properties": {
        "principalId": "[parameters('developerPrincipalId')]",
        "roleDefinitionId": "[format('{0}/sqlRoleDefinitions/{1}', resourceId('Microsoft.DocumentDB/databaseAccounts', format('{0}-cosmos-{1}', parameters('baseName'), variables('uniqueSuffix'))), variables('cosmosDataContributorRoleId'))]",
        "scope": "[resourceId('Microsoft.DocumentDB/databaseAccounts', format('{0}-cosmos-{1}', parameters('baseName'), variables('uniqueSuffix')))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DocumentDB/databaseAccounts', format('{0}-cosmos-{1}', parameters('baseName'), variables('uniqueSuffix')))]"
      ]
    },
    {
      "condition": "[not(empty(parameters('developerPrincipalId')))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[format('Microsoft.CognitiveServices/accounts/{0}', variables('accountName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts', variables('accountName')), parameters('developerPrincipalId'), variables('foundryUserRoleId'))]",
      "properties": {
        "principalId": "[parameters('developerPrincipalId')]",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('foundryUserRoleId'))]",
        "principalType": "User"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('accountName'))]"
      ]
    }
  ],
  "outputs": {
    "foundryAccountName": {
      "type": "string",
      "value": "[variables('accountName')]"
    },
    "foundryProjectName": {
      "type": "string",
      "value": "[parameters('projectName')]"
    },
    "foundryEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('accountName')), '2025-04-01-preview').endpoint]"
    },
    "acrName": {
      "type": "string",
      "value": "[format('{0}acr{1}', parameters('baseName'), variables('uniqueSuffix'))]"
    },
    "acrLoginServer": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', format('{0}acr{1}', parameters('baseName'), variables('uniqueSuffix'))), '2023-07-01').loginServer]"
    },
    "appInsightsConnectionString": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/components', format('{0}-insights-{1}', parameters('baseName'), variables('uniqueSuffix'))), '2020-02-02').ConnectionString]"
    },
    "modelDeploymentName": {
      "type": "string",
      "value": "[parameters('modelName')]"
    },
    "cosmosEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DocumentDB/databaseAccounts', format('{0}-cosmos-{1}', parameters('baseName'), variables('uniqueSuffix'))), '2024-05-15').documentEndpoint]"
    },
    "cosmosDatabaseName": {
      "type": "string",
      "value": "foundry-memo"
    },
    "cosmosConnectionName": {
      "type": "string",
      "value": "cosmos-db"
    },
    "mcpOAuthConnectionName": {
      "type": "string",
      "value": "[if(not(empty(parameters('graphAppClientId'))), 'copilot-search-oauth', '')]"
    }
  }
}